      "projectileCount": 16,
      "projectile": {
        "damage": 10,
        "speed": 520,
        "radius": 12,
        "lifetimeSeconds": 2.8,
        "assetId": "GFX-BOSS-RING-BULLET"
      },
      "gapMarkerRotationDegreesPerSecond": 35,
      "gapRotationDirection": "clockwise",
      "gapRotatesUntilProjectilesGone": true,
      "counterplayKey": "boss.ring.counter"
    },
    {
      "attackId": "boss_summon",
      "nameKey": "boss.summon.name",
      "telegraphSeconds": 0.6,
      "telegraphShape": "circle",
      "telegraphAssetId": "GFX-WARN-CIRCLE",
      "summonEnemyId": "EN-SHIELD",
      "summonPositions": [[560, 250], [1360, 250]],
