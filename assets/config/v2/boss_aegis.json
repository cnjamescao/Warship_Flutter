      "telegraphAssetId": null,
      "exposeSeconds": 3.0,
      "position": "bossCenter",
      "enablesWeakpoint": true,
      "weakpointDamageMultiplier": 1.5,
      "bodyStillTakesNormalDamage": true,
      "assetId": "GFX-BOSS-AEGIS-WEAKPOINT",
      "counterplayKey": "boss.weakpoint.counter"
    }
  ],

  "enrage": {
    "triggerAtSeconds": 180,
    "alsoTriggersWhenPhaseIsP3AndCooldownReadyAndHpAtOrBelow": 0.10,
    "changes": [
      {
        "attackId": "boss_laser",
        "sweepSeconds": 2.2,
        "sameStartAndEndPoints": true,
        "otherParametersUnchanged": true
      }
    ],
    "isOnlyEnrageChange": true
  },

  "assets": {
    "bodyAssetId": "GFX-BOSS-AEGIS-BODY",
    "criticalAssetId": "GFX-BOSS-AEGIS-CRITICAL",
    "weakpointAssetId": "GFX-BOSS-AEGIS-WEAKPOINT",
    "entryAssetId": "GFX-BOSS-ENTRY",
    "phaseAssetId": "GFX-BOSS-PHASE",
    "defeatAssetId": "GFX-BOSS-DEFEAT",
    "nameplateAssetId": "UI-BOSS-NAMEPLATE",
    "warningAssetId": "UI-BOSS-ATTACK-WARN"
