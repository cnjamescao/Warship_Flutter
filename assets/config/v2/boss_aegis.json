      "doesNotTriggerWaveOrEliteEvents": true,
      "blocksNextAttackUntilAllRemoved": true,
      "removalByBreachAlsoUnblocks": true,
      "counterplayKey": "boss.summon.counter"
    },
    {
      "attackId": "boss_laser",
      "nameKey": "boss.laser.name",
      "telegraphSeconds": 0.9,
      "telegraphShape": "line",
      "telegraphAssetId": "GFX-WARN-LINE",
      "sweepSeconds": 1.8,
      "originIsBossCenter": true,
      "sweepFromTargetPoint": [240, 1020],
      "sweepToTargetPoint": [1680, 1020],
      "laserWidth": 60,
      "laserEffectiveLength": 1500,
      "tickSeconds": 0.25,
      "damagePerTick": 8,
      "perTargetPerTickOnce": true,
      "assetId": "GFX-BOSS-LASER",
      "counterplayKey": "boss.laser.counter"
    },
    {
      "attackId": "boss_weakpoint",
      "nameKey": "boss.weakpoint.name",
      "telegraphSeconds": 0.0,
