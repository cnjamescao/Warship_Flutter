    "reduceWhen": {
      "hpAtOrBelow": 35,
      "hpDamageInLast15sAtLeast": 30,
      "scoutDelta": -1,
      "fallbackToWing": true,
      "wingDeltaIfNoScout": -1,
      "appliesToFixedElitesOrBoss": false
